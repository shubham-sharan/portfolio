---
// Standalone, unlisted preview of the book "Hello, AI" for a publisher.
// NOT linked anywhere on the main site. Uses its own layout (no site header/
// nav/footer). Pages are rendered as images so the content and illustrations
// are pixel-exact and the text cannot be selected or copied.
const pad = (n: number) => String(n).padStart(2, '0');
const TOTAL = 22;
const pages = Array.from({ length: TOTAL }, (_, i) => i + 1);
// Anchors: cover = page 1; Chapter 1 starts on page 3; Chapter 2 (book's
// "Capabilities of AI") starts on page 10.
const anchorFor: Record<number, string> = { 1: 'top', 3: 'ch1', 10: 'ch2' };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hello, AI — Preview</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Private preview." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📘</text></svg>" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0;
        -webkit-user-select: none; -moz-user-select: none; user-select: none; }
      :root {
        --ink: #14161a; --muted: #6b7280; --line: #e5e7eb;
        --accent: #4338ca; --sidebar: #ffffff; --reader: #eceef1;
        --serif: Georgia, 'Times New Roman', serif;
        --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      html, body { height: 100%; }
      body { font-family: var(--sans); color: var(--ink); background: var(--reader);
        display: flex; overflow: hidden; }

      /* ---------- sidebar ---------- */
      .sidebar { width: 320px; flex-shrink: 0; height: 100vh; overflow-y: auto;
        background: var(--sidebar); border-right: 1px solid var(--line);
        padding: 2rem 1.6rem; display: flex; flex-direction: column; }
      .brand { display: flex; gap: 0.9rem; align-items: center; margin-bottom: 0.4rem; }
      .brand img { width: 52px; height: auto; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.18);
        pointer-events: none; }
      .brand-tag { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--accent); }
      .book-title { font-family: var(--serif); font-size: 1.5rem; line-height: 1.1;
        margin-top: 1.1rem; letter-spacing: -0.01em; }
      .book-sub { font-family: var(--serif); font-style: italic; color: var(--muted);
        font-size: 0.98rem; margin-top: 0.25rem; }
      .book-meta { font-size: 0.8rem; color: var(--muted); margin-top: 0.7rem; line-height: 1.5; }
      .book-meta b { color: var(--ink); font-weight: 600; }
      .divider { height: 1px; background: var(--line); margin: 1.5rem 0; }

      .toc-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.13em;
        text-transform: uppercase; color: var(--muted); margin-bottom: 0.7rem; }
      .nav a { display: flex; gap: 0.7rem; align-items: baseline; text-decoration: none;
        color: var(--ink); padding: 0.55rem 0.6rem; border-radius: 8px; font-size: 0.92rem;
        line-height: 1.35; transition: background .15s ease, color .15s ease; }
      .nav a:hover { background: #f3f4f6; }
      .nav a.active { background: #eef2ff; color: var(--accent); font-weight: 600; }
      .nav .n { font-size: 0.72rem; font-weight: 700; color: var(--muted); min-width: 1.4rem; }
      .nav a.active .n { color: var(--accent); }
      .nav .cover-link { color: var(--muted); font-size: 0.86rem; }
      .sb-foot { margin-top: auto; padding-top: 1.5rem; font-size: 0.72rem; color: #9ca3af;
        line-height: 1.5; }

      /* ---------- reader ---------- */
      .reader { position: relative; flex: 1; height: 100vh; overflow-y: auto;
        scroll-behavior: smooth; padding: 2.5rem 2rem 5rem; }
      .reader-inner { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column;
        gap: 1.4rem; }
      .leaf { position: relative; border-radius: 6px; overflow: hidden;
        box-shadow: 0 4px 18px rgba(16,18,26,.12); background: #fff; scroll-margin-top: 1.5rem; }
      .leaf img { display: block; width: 100%; height: auto; pointer-events: none;
        -webkit-user-drag: none; user-drag: none; }
      /* transparent shield deters direct image saving / interaction */
      .leaf::after { content: ""; position: absolute; inset: 0; }
      .end-note { text-align: center; color: var(--muted); font-size: 0.82rem;
        padding: 1.5rem 0 0; }

      /* ---------- responsive ---------- */
      @media (max-width: 820px) {
        body { flex-direction: column; overflow: auto; height: auto; }
        .sidebar { width: 100%; height: auto; position: sticky; top: 0; z-index: 10;
          border-right: none; border-bottom: 1px solid var(--line); padding: 1.2rem 1.2rem; }
        .sb-foot { display: none; }
        .reader { height: auto; overflow: visible; padding: 1.5rem 1rem 3rem; }
      }
    </style>
  </head>
  <body oncontextmenu="return false">
    <aside class="sidebar">
      <div class="brand">
        <img src="/ai-book/pages/page-01.png" alt="" />
        <div>
          <div class="brand-tag">Publisher preview</div>
          <div class="book-meta" style="margin-top:.3rem"><b>2-chapter demo</b></div>
        </div>
      </div>
      <div class="book-title">Hello, AI</div>
      <div class="book-sub">Teaching Computers to Think</div>
      <div class="book-meta">By <b>Shubham Sharan</b><br />For ages 10+</div>

      <div class="divider"></div>

      <div class="toc-label">Contents</div>
      <nav class="nav" id="nav">
        <a href="#top" data-t="top" class="cover-link"><span class="n">—</span> Cover &amp; contents</a>
        <a href="#ch1" data-t="ch1"><span class="n">1</span> Chapter 1 — Introduction to AI</a>
        <a href="#ch2" data-t="ch2"><span class="n">2</span> Chapter 2 — Capabilities of AI</a>
      </nav>

      <div class="sb-foot">
        © Shubham Sharan. All rights reserved.<br />
        Confidential preview — not for distribution or reproduction.
      </div>
    </aside>

    <main class="reader" id="reader">
      <div class="reader-inner">
        {pages.map((p) => (
          <figure class="leaf" id={anchorFor[p]}>
            <img src={`/ai-book/pages/page-${pad(p)}.png`} alt={`Page ${p}`} draggable={false} />
          </figure>
        ))}
        <div class="end-note">End of preview · Chapters 1–2</div>
      </div>
    </main>

    <script>
      // --- copy / save deterrents (best-effort; not a hard DRM guarantee) ---
      ['contextmenu', 'dragstart', 'copy', 'cut', 'selectstart'].forEach((ev) =>
        document.addEventListener(ev, (e) => e.preventDefault())
      );
      document.addEventListener('keydown', (e) => {
        const k = e.key.toLowerCase();
        if ((e.ctrlKey || e.metaKey) && ['s', 'p', 'u', 'c'].includes(k)) e.preventDefault();
      });

      // --- scroll-spy: highlight the current chapter ---
      const reader = document.getElementById('reader');
      const links = Array.from(document.querySelectorAll('#nav a'));
      const marks = ['top', 'ch1', 'ch2']
        .map((id) => ({ id, el: document.getElementById(id) }))
        .filter((m) => m.el);
      const setActive = (id) =>
        links.forEach((a) => a.classList.toggle('active', a.dataset.t === id));
      const onScroll = () => {
        const y = reader.scrollTop + 160;
        let active = 'top';
        for (const m of marks) if (m.el.offsetTop <= y) active = m.id;
        setActive(active);
      };
      reader.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
